<?xml version="1.0"?>
<!--
  合成示例：一个两 link + 末端执行器的简化机械臂。
  演示 xacro:include、xacro:property 与 ${name} 参数替换。
  参数：
    arm_length  机械臂长度（米），文件默认 0.35，可由请求参数覆盖
-->
<robot name="example_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="sub/gripper.xacro"/>

  <xacro:property name="arm_length" value="0.35"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
  </link>

  <link name="arm_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 ${arm_length}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 ${arm_length}"/></geometry>
    </collision>
  </link>

  <joint name="base_to_arm" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 ${arm_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <joint name="arm_to_gripper" type="fixed">
    <parent link="arm_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 ${arm_length}" rpy="0 0 0"/>
  </joint>
</robot>
